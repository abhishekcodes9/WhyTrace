# ── Neo4j AuraDB (required for real ingestion and graph investigation) ──
# Use the verified connection URI shown in your Aura console (neo4j+s://...)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── GitHub (optional for public repos; recommended for rate limits) ──
# Fine-grained token with public repository read access.
# Required for private repositories (Contents, Issues, Pull requests: read).
GITHUB_TOKEN=

# ── Google Gemini (optional; deterministic evidence report if absent) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Ingestion bounds (optional) ──
WHYTRACE_MAX_COMMITS=40
WHYTRACE_MAX_COMMIT_DETAILS=18
WHYTRACE_MAX_PULLS=24
WHYTRACE_MAX_ISSUES=24
WHYTRACE_MAX_DOCS=8
WHYTRACE_MAX_PR_COMMENTS=8
WHYTRACE_MAX_ISSUE_COMMENTS=6
